# Build artifacts
build/
*.apk
*.idsig
*.zip

# Signing material — never commit keys
draftguard-release.keystore
release-keystore-base64.txt
*.keystore.base64
release.keystore
release-keystore-base64.txt
*.keystore.base64
*.keystore
*.jks
keystore.properties
*.pepk

# Android / IDE
.gradle/
local.properties
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Recorded data (should never be inside the repo, but just in case)
data/
*.jsonl

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# 导出的个人记录（含隐私内容，不进仓库）
logs-*/

# 个人记录汇总（含隐私内容，只留在本地）
记录汇总*.md
记录汇总*.txt

# 临时调试脚本
dbg*.py
t*.txt
test_out.txt

# 一次性补丁脚本（效果已进代码，无复用价值，不留在仓库）
tools/patch_step*.py
tools/dedup*.py
tools/*_oneoff.py

# 本机私有标识（护栏用；含具体路径，绝不入库）
tools/.private-tokens

# Python 字节码缓存（.pyc 里会残留源码中的绝对路径，绝不能入库）
__pycache__/
*.pyc
