<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.draftguard"
    android:versionCode="1"
    android:versionName="2.0.0">

    <!-- minSdk 26：安卓 8.0 及以上；targetSdk 33：无障碍服务在 14+ 上限制更严，33 最稳 -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 采集主体：无障碍服务 -->
        <service
            android:name=".TypelogService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 诊断探针：仅在应用内开启"诊断日志"后响应，供 ADB 远程排查。
             用法见 docs/TROUBLESHOOTING.md 的"远程调试"一节（adb shell am broadcast）。
             不导出，其他应用无法调用。 -->
        <receiver
            android:name=".ProbeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.draftguard.PROBE" />
            </intent-filter>
        </receiver>

        <!-- 用于把导出的日志 share 给别的 App（避免依赖 androidx FileProvider） -->
        <provider
            android:name=".LogFileProvider"
            android:authorities="com.draftguard.files"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
