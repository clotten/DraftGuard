<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.draftguard"
    android:versionCode="1"
    android:versionName="2.0.0">

    <!-- minSdk 26：安卓 8.0 及以上；targetSdk 33：无障碍服务在 14+ 上限制更严，33 最稳 -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />

    <!-- 保活前台服务所需。本应用依然没有任何联网权限。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 采集主体：无障碍服务 -->
        <service
            android:name=".TypelogService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 保活：常驻通知换取进程不被系统回收。可在应用内关闭。 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keeps the accessibility-based draft recorder process alive" />
        </service>
        <!-- 诊断探针：供 ADB 远程排查，用法见 docs/REMOTE-DEBUG.md。
             必须 exported="true"：否则连 ADB/shell（uid 2000）都发不进来，
             会被 BroadcastQueue 以 "is not exported from uid" 拒绝。
             真正的门是应用内的「诊断日志」开关 —— 默认关闭时本接收器什么都不做；
             打开后它也只是把已有的本地状态打到 logcat，不写入、不外发。 -->
        <receiver
            android:name=".ProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.draftguard.PROBE" />
            </intent-filter>
        </receiver>

        <!-- 用于把导出的日志 share 给别的 App（避免依赖 androidx FileProvider） -->
        <provider
            android:name=".LogFileProvider"
            android:authorities="com.draftguard.files"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
