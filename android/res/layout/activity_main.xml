<?xml version="1.0" encoding="utf-8"?>
<!--
  外层：固定导航栏 + 页面容器。

  页面 1（记录页）改造成"日志页"的常规结构：
    顶部固定：一行摘要（服务状态 + 今天条数）
    然后：搜索行、操作行
    剩下整屏：记录列表（ListView）
  这样打开就看到记录本身，诊断信息收进了「诊断」弹窗。
  列表用 ListView 而不是把内容拼进一个 TextView —— 后者在几百条时会做成一整面文字墙，
  而且 ListView 会回收视图，几百条也不卡。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0F14">

    <!-- 顶部导航栏：每个标签 = 文字 + 自己的下划线（选中时点亮） -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1A1D26"
        android:elevation="4dp">

        <LinearLayout
            android:id="@+id/tabRecords"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navRecordsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="12dp"
                android:text="记录"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/navRecordsBar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#5B9DFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabApps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navAppsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="12dp"
                android:text="应用"
                android:textColor="#8B95A7"
                android:textSize="15sp" />

            <View
                android:id="@+id/navAppsBar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#1A1D26" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 页面 1：记录页。顶部三行由代码填充，其余整屏是列表 -->
        <LinearLayout
            android:id="@+id/page1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <!-- 页面 2：应用列表（图标 + 名字 + 条数），点进去看该应用记录 -->
        <ScrollView
            android:id="@+id/page2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/appsRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
